# The public URL of the site. Used for metadata, the sitemap, and OG images.
NEXT_PUBLIC_APP_URL=https://your-domain.com

# GitHub contributions graph on the home page.
# https://github.com/grubersjoe/github-contributions-api
NEXT_PUBLIC_GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de/v4

# Optional analytics. Leave empty to turn them off.
# https://openpanel.dev
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=

# Optional Google Tag Manager container ID, e.g. GTM-XXXXXXX.
NEXT_PUBLIC_GTM_ID=

# The on-page agent (src/app/api/agent). Server only: never prefix these with
# NEXT_PUBLIC_. Without a key the agent falls back to its on-device router.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: another Gemini model for the agent. Default: gemini-3.5-flash-lite.
AGENT_MODEL=

# Project briefs from the hire dialog (src/app/api/brief), sent with Resend.
# Server only. https://resend.com/api-keys
RESEND_API_KEY=
# Optional sender, on a domain you verified in Resend. Without it, Resend's
# test sender is used, which only delivers to your Resend account's email.
BRIEF_FROM_EMAIL=
# Optional inbox for briefs. Default: the email in the site's user data.
BRIEF_TO_EMAIL=
